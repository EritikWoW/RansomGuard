     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Style="{StaticResource ConnectionDot}" Margin="0,0,9,0"/><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Caption}"/><Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="18,0"/><TextBlock Text="{Binding LastRefresh}" Style="{StaticResource Caption}"/></StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding FooterSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="20,0" ToolTip="{Binding FooterNote}"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Version,StringFormat=RansomGuard v{0}}" Style="{StaticResource Caption}"/><Image Source="{StaticResource BrandShield}" Width="16" Height="19" Margin="14,0,0,0"/></StackPanel>
     <Border Grid.ColumnSpan="3" Background="{DynamicResource InfoSoftBrush}" Visibility="{Binding HasToast,Converter={StaticResource BoolVisibility}}" Padding="10,5" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding Toast}" Foreground="{DynamicResource InfoBrush}" FontSize="12"/></Border>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
