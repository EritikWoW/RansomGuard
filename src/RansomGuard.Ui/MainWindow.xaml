     <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Loc T260}" Command="{Binding NavigateCommand}" CommandParameter="folders" MinHeight="31" Padding="10,5" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Top"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="33"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><icons:SvgIcon Kind="folder" Width="27" Height="27" Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
